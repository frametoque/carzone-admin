name: Build and Deploy Next.js Admin to cPanel

on:
  push:
    branches:
      - main # Change this to 'master' if your default branch is master

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '22'
        cache: 'npm'

    - name: Install Dependencies
      run: npm ci

    - name: Build Next.js App
      env:
        DATABASE_URL: ${{ secrets.NEON_DATABASE_URL }}
        NODE_ENV: production
      run: npm run build

    - name: Remove Unnecessary Dev Bloat
      run: |
        rm -rf node_modules
        rm -rf .git
        rm -rf .github

    - name: Generate cPanel App Auto-Restart Hook
      run: |
        mkdir -p tmp
        touch tmp/restart.txt

    - name: Force Sync All Build Files via FTP
      uses: sebastianpopp/ftp-action@releases/v2
      with:
        host: ${{ secrets.FTP_SERVER }}
        user: ${{ secrets.FTP_USERNAME }}
        password: ${{ secrets.FTP_PASSWORD }}
        forceSsl: false